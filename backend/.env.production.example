# Production environment variables example for Railway + Supabase
NODE_ENV=production
PORT=5000

# PostgreSQL (Supabase)
DATABASE_URL=postgres://<user>:<password>@<host>:5432/<database>

# JWT
JWT_SECRET=replace_with_strong_random_string

# Frontend (used for email links)
FRONTEND_URL=https://your-railway-app.up.railway.app

# Email (SMTP)
EMAIL_SERVICE=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Music Room <noreply@yourdomain.com>"
EMAIL_SECURE=false
EMAIL_REQUIRE_TLS=true

# Optional APIs
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
GENIUS_ACCESS_TOKEN=
