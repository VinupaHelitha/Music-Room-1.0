PORT=5000
NODE_ENV=development

# Spotify API (Optional - for song search)
# Get free credentials from: https://developer.spotify.com/dashboard
# Free tier: 180,000 requests per 6-month rolling window
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Genius API (Optional - for lyrics and song info)
# Get free token from: https://genius.com/api-clients
# Free tier: Unlimited requests
GENIUS_ACCESS_TOKEN=

# JWT Secret (REQUIRED - Change this to a random string!)
# Generate one: https://www.uuidgenerator.net/
JWT_SECRET=your_random_secret_key_minimum_32_characters_change_this

# Database
# Use PostgreSQL for cloud deployment. Example: postgres://user:password@host:port/dbname
DATABASE_URL=postgres://user:password@localhost:5432/music_room

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:3000

# Email Configuration (REQUIRED for email verification and password reset)
# For Gmail: 
#   1. Enable 2-Factor Authentication
#   2. Generate an App Password: https://myaccount.google.com/apppasswords
#   3. Use the app password in EMAIL_PASSWORD
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM="Music Room <your_email@gmail.com>"

# Optional: use a custom SMTP host instead of a named service.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_REQUIRE_TLS=true

# NOTE: We use these FREE services by default:
# - iTunes Search API: Completely free, no key needed (searches songs)
# - LyricsOVH API: Completely free, no key needed (fetches lyrics)
# - Spotify Web API: Free tier available (song search with preview)
# - Genius API: Free tier available (song info & lyrics)
# - Nodemailer with Gmail: Free tier available (email verification)

